# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Redis
REDIS_URL=redis://redis:6379

# Consumer API keys: "key:appName,key2:app2" — each app that calls this API gets one.
# NOTE: injected by the deploy workflow from the API_KEYS GitHub secret.
API_KEYS=replace-me:my-app

# WhatsApp Business (Meta Cloud API)
# NOTE: WA_ACCESS_TOKEN / WA_PHONE_NUMBER_ID / WA_WEBHOOK_VERIFY_TOKEN are
# injected by the deploy workflow from GitHub secrets.
WA_API_VERSION=v22.0
WA_ACCESS_TOKEN=replace-me
WA_PHONE_NUMBER_ID=replace-me
WA_TEMPLATE_NAME=otp_verification
WA_TEMPLATE_LANGUAGE=en_US

# Webhook verification (Meta sends this on webhook registration)
WA_WEBHOOK_VERIFY_TOKEN=replace-me

# OTP defaults
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=10
